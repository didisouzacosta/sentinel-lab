{
	"$schema": "node_modules/wrangler/config-schema.json",
	// SENTINEL LAB — todo recurso Cloudflare deste projeto usa o prefixo
	// "sentinel-lab" e está listado em lab/cloudflare-resources.md. Para apagar
	// tudo: lab/teardown.sh (Worker + domínio + Durable Objects + R2 + Access).
	"name": "sentinel-lab",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-18",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Produção: só o domínio próprio, protegido pelo Cloudflare Access
	// (painel restrito; ingestão /api/*/envelope e /store liberada — ver
	// lab/access.mjs). O workers.dev fica desligado para não existir uma porta
	// sem Access. O Custom Domain é removido junto com o Worker.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "sentinel.adrianosouzacosta.com.br",
			"custom_domain": true
		}
	],
	"build": {
		"command": "cd ../dashboard && npm run build"
	},
	// Kaneo (kaneo.adrianosouzacosta.com.br) is a Worker in the same account,
	// behind Cloudflare Access. The integration reaches it through its
	// KaneoApi entrypoint instead of the internet, so it only needs the
	// Kaneo API key (src/lib/kaneo.ts kaneoFetcher). Other Kaneo URLs still go
	// over HTTPS. Under wrangler dev / vitest the binding is not connected.
	"services": [{ "binding": "KANEO", "service": "kaneo", "entrypoint": "KaneoApi" }],
	"vars": {
		"KANEO_BINDING_ORIGIN": "https://kaneo.adrianosouzacosta.com.br"
	},
	// Attachment blob storage (metadata rows stay in ProjectState). Miniflare
	// (`wrangler dev`, vitest-pool-workers, the integration runner) simulates
	// this bucket from the binding; the production bucket is created by
	// lab/setup.sh (`wrangler r2 bucket create sentinel-lab-attachments`).
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "sentinel-lab-attachments",
			"preview_bucket_name": "sentinel-lab-attachments"
		},
		// Debug files: dSYM objects, ProGuard mappings and sentry-cli upload
		// chunks (lib/debug-files.ts). Created by lab/setup.sh with a 1-day
		// lifecycle rule on chunks/ and staging/.
		{
			"binding": "DEBUG_FILES",
			"bucket_name": "sentinel-lab-debug-files",
			"preview_bucket_name": "sentinel-lab-debug-files"
		}
	],
	// Local dev, the integration suite and CI do not build the Symbolicator
	// image (no Docker needed); they also pass `--var SYMBOLICATION:off`, so
	// events are stored as received. See README "Debug files" for running
	// the container locally.
	"dev": {
		"enable_containers": false
	},
	// Background jobs (src/queue.ts): large sentry-cli assemblies and events
	// waiting for symbolication (src/symbolication-job.ts). Created by
	// lab/setup.sh.
	"queues": {
		"producers": [{ "binding": "PROCESS_QUEUE", "queue": "sentinel-lab-process" }],
		"consumers": [
			{
				"queue": "sentinel-lab-process",
				"max_batch_size": 1,
				"max_retries": 5,
				// At most 4 jobs at once across all projects: with max_instances
				// this caps symbolication work (and cost) during a crash storm.
				// Events that wait too long are stored unsymbolicated
				// (src/symbolication-job.ts SYMBOLICATE_MAX_WAIT_MS).
				"max_concurrency": 4
			}
		]
	},
	// Durable Object bindings
	"durable_objects": {
		"bindings": [
			{
				"name": "AUTH_STATE",
				"class_name": "AuthState"
			},
			{
				"name": "PROJECT_STATE",
				"class_name": "ProjectState"
			},
			// Symbolicator container (src/symbolicator.ts)
			{
				"name": "SYMBOLICATOR",
				"class_name": "Symbolicator"
			}
		]
	},
	// Symbolicator (getsentry/symbolicator) for dSYM and ProGuard/R8
	// symbolication. Needs Workers Paid (Containers) and Docker wherever
	// `wrangler deploy` runs (it builds and pushes the image). One instance
	// per project (src/symbolicator.ts `symbolicatorFor`), each sleeping 3
	// minutes after its last request; `max_instances` caps how many run at
	// once. The container has no internet: it reads debug files from the
	// Worker (outbound interception of http://sentinel.internal), which
	// serves a project's files only to that project's instance.
	"containers": [
		{
			"class_name": "Symbolicator",
			"image": "./symbolicator/Dockerfile",
			"instance_type": "standard-1",
			"max_instances": 10
		}
	],
	// Migrations for SQLite-backed Durable Objects
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AuthState", "ProjectState"]
		},
		// Symbolicator container class. `wrangler rollback` refuses to go
		// back past this migration (AGENTS.md, "Continuous deployment").
		{
			"tag": "v2",
			"new_sqlite_classes": ["Symbolicator"]
		}
	],
	// Serve dashboard static assets
	"assets": {
		"directory": "../dashboard/dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		// The worker answers the API and the MCP endpoint; everything else is
		// the SPA. Without "/mcp" here the assets layer answers POST /mcp with
		// a bare 405 before the worker runs.
		"run_worker_first": ["/api/*", "/mcp"]
	}
}
